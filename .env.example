# Service account credentials. Never use credentials from app users.
# Fill in only the platforms you will sync.
# The in-app Tutorials page (/tutoriais) explains how to get each of these.

# Steam Web API key: https://steamcommunity.com/dev/apikey
ZENKURI_STEAM_API_KEY=

# PSN npsso token: https://ca.account.sony.com/api/v1/ssocookie (signed in at playstation.com).
# It expires; generate a new one and restart the server when sync fails.
ZENKURI_PSN_NPSSO=

# RetroAchievements: your username and the Web API Key from https://retroachievements.org/settings
ZENKURI_RA_USERNAME=
ZENKURI_RA_API_KEY=

# Optional. Uncomment only if you will change them: a variable that is set but empty
# does NOT fall back to the default (the code uses `??`), so do not leave any of them blank.
# ZENKURI_API_PORT=4343
# Default: data/zenkuri.sqlite
# ZENKURI_DB_PATH=
# Default: data/media
# ZENKURI_MEDIA_PATH=
# Default: community/ (community saga and ranking packs)
# ZENKURI_COMMUNITY_DIR=
# Only for migrating an old single-user database
# ZENKURI_LEGACY_USER=
# ZENKURI_LEGACY_PASSWORD=
